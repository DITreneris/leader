{
  "name": "066_leader",
  "version": "1.1.0",
  "description": "Static CEO/COO executive decision operating kit for PromptAnatomy Executive OS",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node --experimental-strip-types ./scripts/generate-llms-full.mjs",
    "build": "astro check && astro build",
    "generate:og": "node ./scripts/generate-og-image.mjs",
    "generate:llms-full": "node --experimental-strip-types ./scripts/generate-llms-full.mjs",
    "build:pdf": "node ./scripts/run-build-pdf.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "optimize:memes": "node ./scripts/optimize-meme-images.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:build": "node ./scripts/verify-build-artifacts.mjs",
    "verify": "npm test && npm run verify:build"
  },
  "keywords": ["promptanatomy", "executive", "ceo", "coo", "astro", "landing"],
  "author": "PromptAnatomy",
  "license": "MIT",
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@vercel/analytics": "^1.6.1",
    "astro": "^6.1.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.0",
    "sharp": "^0.34.5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
