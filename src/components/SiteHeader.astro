---
import { buildPromptAnatomyUrl } from "../constants/outboundLinks";
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const c = uiCopy[lang];
const promptAnatomyHref = buildPromptAnatomyUrl({ medium: "hero", campaign: "primary" });
---

<div class="relative z-50 mx-auto max-w-7xl px-5 sm:px-8">
  <header class="flex items-center justify-between gap-3 py-4 sm:gap-4" data-testid="site-header">
    <a href="#top" class="focus-ring group flex min-w-0 items-center gap-2.5 sm:gap-3" aria-label={c.a11y.logoAriaLabel}>
      <span class="logo-tile logo-glow flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ring-1 ring-white/10 sm:h-10 sm:w-10 sm:rounded-2xl">
        <svg viewBox="0 0 32 32" aria-hidden="true" class="h-5 w-5 sm:h-6 sm:w-6">
          <path
            fill="#fbd304"
            transform="translate(4 3)"
            d="M13.5 1.5 4.5 14.25h6L8.25 22.5 19.5 9.75h-6L13.5 1.5z"
          />
        </svg>
      </span>
      <span class="min-w-0 leading-tight">
        <span class="block text-sm font-black tracking-tight text-white sm:text-base">{c.a11y.brandWordmark}</span>
        <span class="mt-0.5 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">
          {c.a11y.brandSubtag}
        </span>
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-3 sm:gap-4">
      <nav
        class="hidden items-center gap-5 text-sm font-medium text-slate-200 md:flex"
        aria-label={c.a11y.navPrimaryAria}
      >
        <a href="#context" class="focus-ring shrink-0 transition hover:text-white">{c.nav.practice}</a>
        <a href="#demo" class="focus-ring shrink-0 transition hover:text-white">{c.nav.proof}</a>
        <a href="#kit" class="focus-ring shrink-0 transition hover:text-white">{c.nav.kitPdf}</a>
      </nav>

      <a
        href="#context"
        class="focus-ring btn-outline-accent hidden min-h-[2.75rem] items-center justify-center rounded-full px-4 text-sm font-semibold transition md:inline-flex"
      >
        {c.nav.headerCta}
      </a>

      <button
        type="button"
        class="focus-ring inline-flex h-11 w-11 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-white md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={c.a11y.openMobileMenu}
        data-mobile-menu-button
      >
        <span aria-hidden="true" class="flex flex-col gap-1.5">
          <span class="block h-0.5 w-5 rounded-full bg-white"></span>
          <span class="block h-0.5 w-5 rounded-full bg-white"></span>
          <span class="block h-0.5 w-5 rounded-full bg-white"></span>
        </span>
      </button>
    </div>
  </header>

  <div
    id="mobile-menu"
    class="absolute right-0 top-full z-40 mt-2 hidden w-full max-w-[20rem] rounded-2xl border border-white/10 bg-slate-950/95 p-4 shadow-2xl backdrop-blur-xl md:hidden"
    data-mobile-menu-panel
    role="dialog"
    aria-labelledby="mobile-menu-title"
  >
    <p id="mobile-menu-title" class="sr-only">{c.a11y.navMobileAria}</p>
    <nav class="flex flex-col gap-1 text-sm font-medium text-slate-200" aria-label={c.a11y.navMobileAria}>
      <a href="#context" class="focus-ring flex min-h-11 items-center rounded-xl px-3 py-2.5 transition hover:bg-white/5" data-mobile-menu-link>
        {c.nav.practice}
      </a>
      <a href="#demo" class="focus-ring flex min-h-11 items-center rounded-xl px-3 py-2.5 transition hover:bg-white/5" data-mobile-menu-link>
        {c.nav.proof}
      </a>
      <a href="#kit" class="focus-ring flex min-h-11 items-center rounded-xl px-3 py-2.5 transition hover:bg-white/5" data-mobile-menu-link>
        {c.nav.kitPdf}
      </a>
      <a
        href="#context"
        class="focus-ring btn-outline-accent mt-2 inline-flex min-h-[2.75rem] items-center justify-center rounded-full px-4 text-sm font-semibold"
        data-mobile-menu-link
      >
        {c.nav.headerCta}
      </a>
      <a
        href={promptAnatomyHref}
        target="_blank"
        rel="noopener noreferrer"
        class="focus-ring mt-1 flex min-h-11 items-center px-3 py-2.5 text-sm font-medium text-slate-400 transition hover:bg-white/5 hover:text-white"
        data-mobile-menu-link
      >
        {c.hero.productCta} →
      </a>
    </nav>
  </div>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-mobile-menu-button]");
  const panel = document.querySelector<HTMLElement>("[data-mobile-menu-panel]");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-mobile-menu-link]");

  const isExpanded = () => btn?.getAttribute("aria-expanded") === "true";

  const getFocusableInPanel = (): HTMLElement[] => {
    if (!panel) return [];
    const nodes = panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
    return Array.from(nodes).filter((el) => !el.hasAttribute("disabled"));
  };

  const close = () => {
    if (!panel || !btn) return;
    panel.classList.add("hidden");
    btn.setAttribute("aria-expanded", "false");
    btn.focus({ preventScroll: true });
  };

  const open = () => {
    if (!panel || !btn) return;
    panel.classList.remove("hidden");
    btn.setAttribute("aria-expanded", "true");
    panel.querySelector<HTMLElement>("[data-mobile-menu-link]")?.focus({ preventScroll: true });
  };

  const toggle = () => {
    if (!panel || !btn) return;
    const expanded = isExpanded();
    if (expanded) close();
    else open();
  };

  btn?.addEventListener("click", toggle);

  links.forEach((a) => a.addEventListener("click", close));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (isExpanded()) close();
      return;
    }
    if (e.key !== "Tab" || !isExpanded() || !panel) return;
    const focusables = getFocusableInPanel();
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;
    if (e.shiftKey) {
      if (active === first) {
        e.preventDefault();
        last.focus();
      }
    } else if (active === last) {
      e.preventDefault();
      first.focus();
    }
  });

  document.addEventListener("pointerdown", (e) => {
    if (!panel || !btn || !isExpanded()) return;
    const target = e.target as Node | null;
    if (!target) return;
    if (panel.contains(target)) return;
    if (btn.contains(target)) return;
    close();
  });

  window.addEventListener(
    "scroll",
    () => {
      if (!isExpanded()) return;
      close();
    },
    { passive: true }
  );

  window.addEventListener("hashchange", () => {
    if (!isExpanded()) return;
    close();
  });
</script>
