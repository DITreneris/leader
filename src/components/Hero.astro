---
import HeroDecisionDiagram from "./HeroDecisionDiagram.astro";
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const c = uiCopy[lang];
---

<section
  class="relative mx-auto grid max-w-7xl gap-12 px-5 pb-14 pt-10 sm:px-8 sm:gap-14 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1fr)] lg:items-start lg:gap-14 lg:pb-16 lg:pt-14"
>
  <div class="relative z-10 flex flex-col">
    <p
      class="hero-enter hero-enter--1 mb-6 inline-flex w-fit self-start flex-wrap items-center rounded-full border border-brand-accent/30 bg-brand-accent/15 px-3 py-2 text-sm font-semibold leading-snug text-brand-accent-hover"
    >
      {c.hero.eyebrow}
    </p>
    <h1
      class="hero-enter hero-enter--2 max-w-[22rem] text-4xl font-black tracking-tight text-white sm:max-w-xl sm:text-5xl lg:max-w-2xl lg:text-6xl"
      data-testid="hero-heading"
    >
      {c.hero.title}
    </h1>
    <p class="hero-enter hero-enter--3 mt-8 max-w-2xl text-lg leading-[1.65] text-slate-300 sm:text-xl sm:leading-relaxed">
      {c.hero.subtitle}
    </p>

    <div class="hero-enter hero-enter--4 mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
      <a
        href="#context"
        class="focus-ring btn-primary-gold cta-gradient elevate-hover w-full sm:w-auto"
      >
        {c.hero.inPageCta}
      </a>
    </div>
    <p class="mt-4 text-[0.9375rem] text-slate-300">{c.hero.ctaMeta}</p>
  </div>

  <div>
    <HeroDecisionDiagram lang={lang} />
  </div>
</section>
