---
import BulletSystem from "./ds/BulletSystem.astro";
import ContentCard from "./ds/ContentCard.astro";
import SectionShell from "./ds/SectionShell.astro";
import SectionTitleBlock from "./ds/SectionTitleBlock.astro";
import { buildSisterHubUrl } from "../constants/outboundLinks";
import type { FaqSectionAnchor } from "../utils/pageJsonLd";
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { faq } = uiCopy[lang];
const sisterHubFaqHref = buildSisterHubUrl({ medium: "faq", campaign: "framework_basics" });

const sectionAnchorHref: Record<FaqSectionAnchor, string> = {
  context: "#context",
  demo: "#demo",
  kit: "#kit",
  safety: "#safety-check",
};
---

<SectionShell id="faq" labelledby="faq-heading">
  <div class="mx-auto max-w-2xl">
    <SectionTitleBlock title={faq.sectionTitle} titleId="faq-heading" titleScale="compact" />

    <div class="mt-8 space-y-2">
      {
        faq.items.map((item) => (
          <ContentCard surface="glass" radius="lg" padding="compact" as="div">
            <details class="group">
            <summary class="focus-ring summary-hover cursor-pointer list-none py-1 text-left text-sm font-semibold text-slate-200 outline-none sm:text-base [&::-webkit-details-marker]:hidden">
              {item.q}
            </summary>
            <div class="border-t border-white/10 pb-1 pt-2 text-sm leading-relaxed">
              {item.bullets?.length ? (
                <>
                  <p class="text-slate-300">{item.a}</p>
                  <BulletSystem variant="muted" class="mt-2">
                    {item.bullets.map((line) => (
                      <li>{line}</li>
                    ))}
                  </BulletSystem>
                </>
              ) : (
                <p class="type-body-support">{item.a}</p>
              )}
              {"sectionAnchor" in item && item.sectionAnchor && "sectionLinkLabel" in item && item.sectionLinkLabel ? (
                <p class="mt-3">
                  <a
                    href={sectionAnchorHref[item.sectionAnchor]}
                    class="focus-ring font-semibold text-brand-accent-hover underline decoration-brand-accent/40 underline-offset-4 transition hover:text-brand-accent"
                  >
                    {item.sectionLinkLabel}
                  </a>
                </p>
              ) : null}
              {"handoff" in item && item.handoff === "sister_hub" ? (
                <p class="mt-3">
                  <a
                    href={sisterHubFaqHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="focus-ring font-semibold text-brand-accent-hover underline decoration-brand-accent/40 underline-offset-4 transition hover:text-brand-accent"
                  >
                    {faq.sisterHubLinkLabel}
                  </a>
                </p>
              ) : null}
            </div>
          </details>
          </ContentCard>
        ))
      }
    </div>
  </div>
</SectionShell>
