---
import SectionShell from "./ds/SectionShell.astro";
import { buildPromptAnatomyUrl } from "../constants/outboundLinks";
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const cta = uiCopy[lang].cta;
const downloadHref = `${import.meta.env.BASE_URL}assets/downloads/executive-operating-kit.pdf`.replace(/([^:]\/)\/+/g, "$1");
const promptAnatomySecondaryHref = buildPromptAnatomyUrl({
  medium: "lead_magnet",
  campaign: "executive_prompt_library",
});
---

<SectionShell id="kit" anchorFocusable>
  <div class="radius-xl relative overflow-hidden border border-white/10 bg-[#0b1320] p-8 text-white sm:p-12">
    <div class="relative max-w-3xl">
      <p class="type-eyebrow-promo text-brand-accent">{cta.eyebrow}</p>
      <h2 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">
        {cta.title}
      </h2>
      {
        cta.subtitle && (
          <p class="mt-5 text-lg leading-8 text-slate-300">
            {cta.subtitle}
          </p>
        )
      }
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={downloadHref}
          download="executive-operating-kit.pdf"
          data-kit-download
          class="focus-ring btn-primary-gold cta-gradient elevate-hover"
        >
          {cta.primary}
        </a>
        <a
          href={promptAnatomySecondaryHref}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring inline-flex min-h-[2.75rem] items-center justify-center rounded-full border border-white/20 px-6 text-center text-sm font-semibold text-white transition hover:bg-white/10"
        >
          {cta.secondary}
        </a>
      </div>
    </div>
  </div>
</SectionShell>
