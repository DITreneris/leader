---
import ContentCard from "./ds/ContentCard.astro";
import WorkflowStepRail from "./ds/WorkflowStepRail.astro";
import PasteDestinationStrip from "./ds/PasteDestinationStrip.astro";
import HighlightStrip from "./ds/HighlightStrip.astro";
import SectionShell from "./ds/SectionShell.astro";
import SectionTitleBlock from "./ds/SectionTitleBlock.astro";
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const modules = uiCopy[lang].modules;
const FEATURED_MODULE_ID = "secondOrder";
const inputClass =
  "focus-ring input-executive mt-2 w-full radius-lg px-4 py-3 text-sm font-semibold text-slate-100";
---

<SectionShell id="context" labelledby="context-title" anchorFocusable>
  <SectionTitleBlock eyebrow={modules.eyebrow} title={modules.title} subtitle={modules.subtitle} titleId="context-title" />

  <div class="mx-auto mt-8 max-w-4xl">
    <WorkflowStepRail ariaLabel={modules.workflowAriaLabel} steps={modules.workflowSteps} />
  </div>

  <div class="mx-auto mt-8 flex max-w-6xl flex-col gap-5">
    <ContentCard surface="glass" padding="comfort" overflow="hidden" class="mx-auto w-full max-w-4xl">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p class="type-eyebrow-inline text-brand-accent-hover">{modules.context.title}</p>
        <span class="type-micro-label rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-slate-200">
          {modules.context.badge}
        </span>
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-200">{modules.context.subtitle}</p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div>
          <label class="type-form-label-readable" for="ctx-company">
            {modules.context.companyLabel}
          </label>
          <input
            id="ctx-company"
            name="ctx-company"
            type="text"
            placeholder={modules.context.companyPlaceholder}
            class={inputClass}
            data-context-field="company"
            autocomplete="organization"
          />
        </div>

        <div>
          <label class="type-form-label-readable" for="ctx-goal">
            {modules.context.goalLabel}
          </label>
          <input
            id="ctx-goal"
            name="ctx-goal"
            type="text"
            placeholder={modules.context.goalPlaceholder}
            class={inputClass}
            data-context-field="goal"
            autocomplete="off"
          />
        </div>

        <div>
          <label class="type-form-label-readable" for="ctx-constraint">
            {modules.context.constraintLabel}
          </label>
          <input
            id="ctx-constraint"
            name="ctx-constraint"
            type="text"
            placeholder={modules.context.constraintPlaceholder}
            class={inputClass}
            data-context-field="constraint"
            autocomplete="off"
          />
        </div>

        <div>
          <label class="type-form-label-readable" for="ctx-bottleneck">
            {modules.context.bottleneckLabel}
          </label>
          <input
            id="ctx-bottleneck"
            name="ctx-bottleneck"
            type="text"
            placeholder={modules.context.bottleneckPlaceholder}
            class={inputClass}
            data-context-field="bottleneck"
            autocomplete="off"
          />
        </div>
      </div>

      <p
        class="mt-4 text-sm leading-6 text-amber-200/90"
        data-context-status
        role="status"
        aria-live="polite"
      >
        {modules.contextStatusEmpty}
      </p>

      <details class="surface-panel radius-lg mt-6 border-white/15 p-4">
        <summary class="focus-ring summary-hover -m-2 min-h-11 radius-lg px-2 py-3 text-sm font-semibold text-slate-200">
          {modules.rulesPreview.title}
        </summary>
        <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-200">
          {modules.rulesPreview.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </details>
    </ContentCard>

    <HighlightStrip variant="band" bandTone="context">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p>{modules.startHere}</p>
        <a
          href="#module-secondOrder"
          class="focus-ring btn-outline-accent shrink-0 rounded-full px-5 py-3 text-center text-sm font-bold"
        >
          {modules.nextStepCta} →
        </a>
      </div>
    </HighlightStrip>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        modules.items.map((m) => {
          const isFeatured = m.id === FEATURED_MODULE_ID;
          return (
            <ContentCard
              surface={isFeatured ? "accent" : "surface"}
              as="article"
              padding="compact"
              overflow="hidden"
              moduleCard
              moduleId={m.id}
              id={isFeatured ? "module-secondOrder" : undefined}
              class:list={["flex h-full flex-col", isFeatured && "module-card-featured"]}
            >
              <div class="flex-1">
                {isFeatured && (
                  <span class="type-micro-label mb-3 inline-block rounded-full border border-brand-accent/35 bg-brand-accent/15 px-3 py-1 text-brand-accent-hover">
                    {modules.recommendedBadge}
                  </span>
                )}
                <p class="type-eyebrow-inline text-brand-accent">{m.category}</p>
                <h3 class="mt-3 text-xl font-black text-white">{m.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-200">{m.subtitle}</p>
                <p class="mt-2 type-body-support">{m.bestFor}</p>
                <p class="mt-3 type-body-support">
                  <span class="font-semibold text-slate-200">{modules.outputLabel}:</span>{" "}
                  {m.outputPreviewLine}
                </p>

                <details class="surface-panel radius-lg mt-4 p-4" open={isFeatured ? true : undefined}>
                  <summary class="focus-ring summary-hover -m-2 min-h-11 radius-lg px-2 py-3 text-sm font-semibold text-slate-200">
                    {modules.taskLabel}
                  </summary>
                  <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-200">{m.taskFormat}</p>
                </details>

                <details class="surface-panel radius-lg mt-4 p-4">
                  <summary class="focus-ring summary-hover -m-2 min-h-11 radius-lg px-2 py-3 text-sm font-semibold text-slate-200">
                    {modules.outputLabel}
                  </summary>
                  <pre
                    class="text-prompt-preview mt-3 max-h-40 overflow-auto whitespace-pre-wrap [tab-size:2]"
                    tabindex="0">{m.outputExampleJson}</pre>
                </details>

                {isFeatured && (
                  <details class="surface-panel radius-lg mt-4 p-4" data-module-preview={m.id}>
                    <summary class="focus-ring summary-hover -m-2 min-h-11 radius-lg px-2 py-3 text-sm font-semibold text-slate-200">
                      {modules.previewPromptLabel}
                    </summary>
                    <pre
                      class="text-prompt-preview mt-3 max-h-48 overflow-auto whitespace-pre-wrap [tab-size:2]"
                      data-module-preview-content={m.id}
                      tabindex="0"
                    />
                  </details>
                )}
              </div>

              <button
                type="button"
                class="focus-ring btn-outline-accent elevate-hover mt-5 rounded-full px-4 py-3 text-sm font-bold"
                data-module-copy={m.id}
                data-copy-label-i18n="modules.copyButton"
                data-copy-copied-i18n="modules.copiedButton"
              >
                {modules.copyButton}
              </button>
            </ContentCard>
          );
        })
      }
    </div>

    <ContentCard
      surface="glass"
      as="article"
      padding="compact"
      overflow="hidden"
      moduleCard
      moduleId="custom"
      class="flex h-full flex-col"
    >
      <div class="flex-1">
        <p class="type-eyebrow-inline text-brand-accent">{modules.custom.eyebrow}</p>
        <h3 class="mt-3 text-xl font-black text-white">{modules.custom.title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-200">{modules.custom.subtitle}</p>

        <div class="mt-5 grid gap-4 lg:grid-cols-2">
          <div>
            <label class="type-form-label-readable" for="custom-task">
              {modules.custom.taskLabel}
            </label>
            <textarea
              id="custom-task"
              class:list={[inputClass, "min-h-36 radius-xl leading-6"]}
              placeholder={modules.custom.taskPlaceholder}
              data-custom-task
            />
          </div>

          <div>
            <label class="type-form-label-readable" for="custom-output">
              {modules.custom.outputLabel}
            </label>
            <div class="mt-2 flex flex-wrap gap-2">
              {
                modules.custom.outputPresets.map((preset) => (
                  <button
                    type="button"
                    class="focus-ring btn-chip min-h-11 rounded-full px-4 py-3 text-sm font-semibold"
                    data-custom-preset={preset.id}
                  >
                    {preset.label}
                  </button>
                ))
              }
            </div>
            <textarea
              id="custom-output"
              class:list={[inputClass, "mt-3 min-h-36 radius-xl leading-6"]}
              placeholder={modules.custom.outputPlaceholder}
              data-custom-output
            />
          </div>
        </div>

        <p class="mt-3 text-sm font-semibold text-rose-100 hidden" data-custom-error role="status" aria-live="polite" />
      </div>

      <button
        type="button"
        class="focus-ring btn-primary-gold cta-gradient elevate-hover mt-5 max-w-xs self-start"
        data-custom-copy
        data-copy-label-i18n="modules.custom.copyButton"
        data-copy-copied-i18n="modules.custom.copiedButton"
      >
        {modules.custom.copyButton}
      </button>
    </ContentCard>

    <PasteDestinationStrip lang={lang} surface="context" revealOnCopy />
  </div>
</SectionShell>
