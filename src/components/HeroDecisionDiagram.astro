---
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const v = uiCopy[lang].heroDiagram;
const b = v.brief;
const chipCount = v.noise.chips.length;

const noisePanelId = "hero-split-noise-title";
const decisionBlockId = "hero-split-decision-title";
---

<aside class="hero-split" aria-label={v.ariaLabel} data-testid="hero-diagram">
  <div class="hero-split__card glass-card radius-xl">
    <p class="hero-split__eyebrow type-micro-label text-slate-400">{v.label}</p>

    <div class="hero-split__panels">
      <section
        class="hero-split__panel hero-split__panel--noise"
        aria-labelledby={noisePanelId}
        tabindex="0"
      >
        <h2 class="hero-split__panel-title hero-split__panel-title--noise" id={noisePanelId}>
          {v.noise.title}
        </h2>
        <div class="hero-split__chips">
          {
            v.noise.chips.map((chip, index) => (
              <div
                class:list={[
                  "hero-split__chip",
                  index === chipCount - 1 && "hero-split__chip--muted",
                ]}
                style={`--hero-chip-i: ${index}`}
              >
                <span class="hero-split__chip-label">{chip.label}</span>
                <span class="hero-split__chip-detail">{chip.detail}</span>
              </div>
            ))
          }
        </div>
      </section>

      <span class="hero-split__connector" aria-hidden="true" data-testid="hero-connector">→</span>

      <section
        class="hero-split__panel hero-split__panel--brief"
        aria-labelledby={decisionBlockId}
        tabindex="0"
      >
        <div class="hero-split__brief-body">
          <div class="hero-split__decision-block" style="--hero-brief-i: 0">
            <span class="hero-split__field-label hero-split__field-label--decision" id={decisionBlockId}>
              {b.decision.label}
            </span>
            <div class="hero-split__decision-lines">
              {b.decision.lines.map((line) => (
                <p class="hero-split__decision-line">{line}</p>
              ))}
            </div>
          </div>

          <div class="hero-split__why-row" style="--hero-brief-i: 1">
            <span class="hero-split__field-label">{b.why.label}</span>
            <p class="hero-split__field-line">{b.why.line}</p>
          </div>

          <div class="hero-split__brief-footer" style="--hero-brief-i: 2">
            <div class="hero-split__meta-grid">
              <div class="hero-split__meta-cell">
                <span class="hero-split__field-label">{b.owner.label}</span>
                <p class="hero-split__field-line">{b.owner.line}</p>
              </div>
              <div class="hero-split__meta-cell hero-split__meta-cell--risk">
                <span class="hero-split__field-label">{b.risk.label}</span>
                <p class="hero-split__field-line">{b.risk.line}</p>
              </div>
            </div>

            <div class="hero-split__next-row">
              <span class="hero-split__field-label">{b.nextAction.label}</span>
              <p class="hero-split__field-line hero-split__field-line--action">
                <span class="hero-split__next-arrow" aria-hidden="true">→</span>
                {b.nextAction.line}
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</aside>
