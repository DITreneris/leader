---
interface Props {
  id?: string;
  /** Maps to `aria-labelledby` */
  labelledby?: string;
  /** Maps to `aria-label` when no heading id */
  label?: string;
  /** Vertical section rhythm — see `docs/DESIGN_SYSTEM.md` */
  rhythm?: "default" | "tight" | "compact" | "roomy";
  /** When true, section is focusable for in-page hash navigation (tabindex="-1"). */
  anchorFocusable?: boolean;
  /** Semantic wrapper — default `section`; use `aside` for MemeMoment beats */
  as?: "section" | "aside";
  class?: string;
}

const {
  id,
  labelledby,
  label,
  rhythm = "default",
  anchorFocusable = false,
  as = "section",
  class: className,
} = Astro.props as Props;

const rhythmClass =
  rhythm === "tight"
    ? "section-y-tight"
    : rhythm === "compact"
      ? "section-y-compact"
      : rhythm === "roomy"
        ? "section-y section-y-roomy-lg"
        : "section-y";

const Tag = as;
---

<Tag
  id={id}
  tabindex={anchorFocusable ? -1 : undefined}
  aria-labelledby={labelledby}
  aria-label={label}
  class:list={[rhythmClass, "mx-auto max-w-7xl px-5 sm:px-8", className]}
>
  <slot />
</Tag>
