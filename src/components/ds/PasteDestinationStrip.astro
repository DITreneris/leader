---
import { buildConsumerAiUrl } from "../../constants/outboundLinks";
import type { Language } from "../../content/copy";
import { uiCopy } from "../../content/copy";

interface Props {
  lang: Language;
  surface: "context" | "demo";
  /** Extra top margin: default works for #context; use "tight" under demo copy row */
  spacing?: "default" | "tight";
  /** Hide until first successful copy (#context modules or #demo prompt) */
  revealOnCopy?: boolean;
}

const { lang, surface, spacing = "default", revealOnCopy = false } = Astro.props;
const p = uiCopy[lang].pasteIntoAssistant;

const topClass = spacing === "tight" ? "mt-5" : "mt-8 sm:mt-10";

const links = [
  { href: buildConsumerAiUrl({ surface, provider: "chatgpt" }), label: p.openChatgpt },
  { href: buildConsumerAiUrl({ surface, provider: "claude" }), label: p.openClaude },
  { href: buildConsumerAiUrl({ surface, provider: "gemini" }), label: p.openGemini },
] as const;
---

<div
  class:list={[
    "surface-panel radius-lg card-padding-compact mx-auto max-w-2xl",
    topClass,
    revealOnCopy && "hidden",
  ]}
  data-paste-destination-strip={revealOnCopy ? surface : undefined}
  aria-label={p.ariaLabel}
>
  <p class="text-center text-sm leading-relaxed text-slate-200 sm:text-base" data-paste-lead>
    {p.lead}
  </p>

  <div class="mt-5 text-center">
    <p class="type-micro-label-readable text-slate-400">{p.continueLabel}</p>
    <div class="mt-3 flex flex-col items-stretch gap-2 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-3">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-ring paste-destination-link inline-flex min-h-11 w-full items-center justify-center px-4 py-2.5 text-center text-sm font-semibold text-slate-300 sm:w-auto"
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>

  <p class="mx-auto mt-4 max-w-lg text-center text-xs leading-relaxed text-slate-400">{p.licenseNote}</p>
</div>
