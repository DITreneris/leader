---
import SectionShell from "./ds/SectionShell.astro";
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const anatomy = uiCopy[lang].anatomy;
const lastItemIndex = anatomy.items.length - 1;
---

<SectionShell id="anatomy" labelledby="anatomy-heading">
  <details class="group glass-card radius-xl overflow-hidden border border-white/10 open:border-brand-accent/25">
    <summary class="focus-ring summary-hover cursor-pointer list-none p-6 outline-none sm:p-8 [&::-webkit-details-marker]:hidden">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <p class="type-section-eyebrow">{anatomy.eyebrow}</p>
          <h2 id="anatomy-heading" class="mt-4 text-4xl font-black tracking-tight text-white sm:text-5xl">
            {anatomy.title}
          </h2>
          <p class="mt-3 text-sm font-semibold text-brand-accent-hover/90 sm:text-base">
            {anatomy.expandSummary}
          </p>
          <p class="mt-4 text-lg leading-8 text-slate-300">
            {anatomy.subtitle}
          </p>
          <ul
            class="mt-5 flex flex-wrap gap-2"
            aria-label={anatomy.previewAriaLabel}
          >
            {
              anatomy.items.map((item) => (
                <li class="list-none">
                  <span class="inline-block rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 text-xs font-bold text-slate-200 sm:text-sm">
                    {item.title}
                  </span>
                </li>
              ))
            }
          </ul>
          {
            anatomy.referenceNote ? (
              <p class="mt-4 text-sm leading-relaxed text-slate-400">{anatomy.referenceNote}</p>
            ) : null
          }
        </div>
        <span
          aria-hidden="true"
          class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-brand-accent transition motion-safe:group-open:rotate-180 group-open:border-brand-accent/40 group-open:bg-brand-accent/15"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-6 w-6"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z"
              clip-rule="evenodd"></path>
          </svg>
        </span>
      </div>
    </summary>

    <div class="border-t border-white/10 p-6 sm:p-8 sm:pt-6">
      <div class="grid gap-4 sm:grid-cols-2">
        {
          anatomy.items.map((item, index) => (
            <article
              id={`anatomy-block-${item.id}`}
              class:list={[
                "radius-lg border border-white/10 bg-white/[0.02] p-4 sm:p-5",
                index === lastItemIndex && "sm:col-span-2",
              ]}
            >
              <p class="type-eyebrow-inline text-slate-400">
                {anatomy.stepPrefix} {index + 1}
              </p>
              <h3 class="text-xl font-black text-white">{item.title}</h3>

              <p class="type-micro-label mt-4 text-slate-500">{anatomy.definitionLabel}</p>
              <p class="mt-1 text-sm leading-6 text-slate-300">{item.body}</p>

              <p class="type-micro-label mt-4 text-slate-500">{anatomy.exampleLabel}</p>
              <p class="mt-1 rounded-md border border-white/[0.06] bg-white/[0.03] px-3 py-2 font-mono text-xs leading-5 text-slate-400">
                {item.example}
              </p>

              <p class="type-micro-label mt-4 text-slate-500">{anatomy.onPageLead}</p>
              <a
                href={item.onPageHref}
                class="focus-ring mt-1 inline-block text-sm font-semibold text-brand-accent-hover transition hover:text-brand-accent"
              >
                {item.onPageLabel}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </details>
</SectionShell>
