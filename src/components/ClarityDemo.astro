---
import ContentCard from "./ds/ContentCard.astro";
import PasteDestinationStrip from "./ds/PasteDestinationStrip.astro";
import HighlightStrip from "./ds/HighlightStrip.astro";
import SectionShell from "./ds/SectionShell.astro";
import SectionTitleBlock from "./ds/SectionTitleBlock.astro";
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const demo = uiCopy[lang].demo;
const scenarioKeys = ["meeting", "report", "decision", "delegation", "communication"] as const;
const defaultScenario = demo.scenarios.meeting;
const hasDecisionBullets =
  defaultScenario.decisionBullets != null && defaultScenario.decisionBullets.length > 0;
---

<SectionShell id="demo" anchorFocusable>
  <SectionTitleBlock eyebrow={demo.eyebrow} title={demo.title} subtitle={demo.subtitle} />

  <p id="demo-scenario-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

  <ContentCard
    surface="glass"
    padding="none"
    overflow="hidden"
    as="article"
    ariaLive="polite"
    ariaAtomic={true}
    class="mx-auto stack-after-section-title max-w-5xl"
  >
    <div class="border-b border-white/10 px-4 py-4 sm:px-6">
      <div class="flex flex-wrap justify-center gap-3">
        {
          scenarioKeys.map((scenario, index) => (
            <button
              type="button"
              data-scenario={scenario}
              data-active={index === 0 ? "true" : "false"}
              class="focus-ring btn-chip elevate-hover min-h-12 rounded-full px-6 py-3.5 text-base font-bold text-slate-200"
            >
              {demo.scenarios[scenario].label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="card-padding-comfort">
      <h3
        class="text-xl font-bold leading-tight text-white sm:text-2xl"
        data-demo-field="title"
      >
        {defaultScenario?.title ?? ""}
      </h3>

      <p class="type-micro-label-readable mt-6 text-slate-400">
        {demo.briefLabel}
      </p>

      <div class="mt-4 grid gap-3">
        <div class="surface-panel radius-lg border-t-2 border-t-brand-accent/35 p-4">
          <p class="type-micro-label-readable text-slate-400">
            {demo.insight}
          </p>
          <p
            class="mt-2 text-base font-semibold leading-7 text-slate-100"
            data-demo-field="insight"
          >
            {defaultScenario.insight}
          </p>
        </div>

        <div class="surface-panel radius-lg p-4">
          <p class="type-micro-label-readable text-slate-400">
            {demo.decision}
          </p>
          <p
            class:list={[
              "mt-2 text-base font-semibold leading-7 text-white",
              hasDecisionBullets && "hidden",
            ]}
            data-demo-field="decision"
          >
            {defaultScenario.decision}
          </p>
          <ul
            class:list={[
              "mt-2 list-disc space-y-2 pl-5 text-base font-semibold leading-7 text-white",
              !hasDecisionBullets && "hidden",
            ]}
            data-demo-decision-bullets
          >
            {defaultScenario.decisionBullets?.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </div>

        <div class="surface-panel radius-lg p-4">
          <p class="type-micro-label-readable text-slate-400">
            {demo.action}
          </p>
          <p class="mt-2 text-base font-semibold leading-7 text-white" data-demo-field="action">
            {defaultScenario.action}
          </p>
        </div>
      </div>

      <div
        class="mt-6 inline-flex w-full flex-wrap items-stretch justify-center gap-1 radius-md border border-white/10 bg-slate-950/40 p-1 sm:w-auto sm:justify-start"
        role="tablist"
        aria-label={demo.secondaryTablistAriaLabel}
      >
        <button
          type="button"
          class="focus-ring min-h-11 flex-1 radius-sm px-4 py-2.5 text-sm font-semibold text-slate-300 transition aria-selected:bg-brand-accent/20 aria-selected:text-white sm:min-h-0 sm:flex-none"
          id="demo-tab-details"
          role="tab"
          data-demo-tab="details"
          aria-selected="false"
          aria-label={demo.detailsTab}
          aria-controls="demo-details-panel"
          tabindex="0"
        >
          <span class="sm:hidden">{demo.detailsTabShort}</span>
          <span class="hidden sm:inline">{demo.detailsTab}</span>
        </button>
        <button
          type="button"
          class="focus-ring min-h-11 flex-1 radius-sm px-4 py-2.5 text-sm font-semibold text-slate-300 transition aria-selected:bg-brand-accent/20 aria-selected:text-white sm:min-h-0 sm:flex-none"
          id="demo-tab-input"
          role="tab"
          data-demo-tab="input"
          aria-selected="false"
          aria-label={demo.inputTab}
          aria-controls="demo-input-panel"
          tabindex="-1"
        >
          <span class="sm:hidden">{demo.inputTabShort}</span>
          <span class="hidden sm:inline">{demo.inputTab}</span>
        </button>
        <button
          type="button"
          class="focus-ring min-h-11 flex-1 radius-sm px-4 py-2.5 text-sm font-semibold text-slate-300 transition aria-selected:bg-brand-accent/20 aria-selected:text-white sm:min-h-0 sm:flex-none"
          id="demo-tab-prompt"
          role="tab"
          data-demo-tab="prompt"
          aria-selected="false"
          aria-label={demo.promptTab}
          aria-controls="demo-prompt-panel"
          tabindex="-1"
        >
          <span class="sm:hidden">{demo.promptTabShort}</span>
          <span class="hidden sm:inline">{demo.promptTab}</span>
        </button>
      </div>

      {
        demo.secondaryPanelHint ? (
          <p class="mt-4 text-sm leading-relaxed text-slate-400" data-demo-secondary-placeholder>
            {demo.secondaryPanelHint}
          </p>
        ) : null
      }

      <div
        id="demo-details-panel"
        class="hidden mt-4 border-t border-white/10 pt-4"
        role="tabpanel"
        aria-labelledby="demo-tab-details"
      >
        <div class="grid gap-4 md:grid-cols-2">
          <div class="surface-panel radius-lg p-4">
            <p class="type-micro-label-readable text-slate-400">
              {demo.risks}
            </p>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-200" data-demo-risks>
              {defaultScenario.risks.map((risk) => (
                <li>{risk}</li>
              ))}
            </ul>
          </div>
          <div class="surface-panel radius-lg p-4">
            <p class="type-micro-label-readable text-slate-400">
              {demo.questions}
            </p>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-200" data-demo-questions>
              {defaultScenario.questions.map((question) => (
                <li>{question}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div
        id="demo-input-panel"
        class="hidden mt-4 border-t border-white/10 pt-4"
        role="tabpanel"
        aria-labelledby="demo-tab-input"
      >
        <div class="surface-panel radius-lg p-4">
          <p class="type-micro-label-readable text-slate-400">
            {demo.messyInputLabel}
          </p>
          <p class="mt-3 text-sm leading-6 text-slate-200" data-demo-field="input">
            {defaultScenario.input}
          </p>
        </div>
      </div>

      <div
        id="demo-prompt-panel"
        class="hidden mt-4 border-t border-white/10 pt-4"
        role="tabpanel"
        aria-labelledby="demo-tab-prompt"
      >
        <div class="surface-panel radius-lg p-4">
          <p class="type-micro-label-readable text-slate-400">
            {demo.promptBlockLabel}
          </p>
          <pre
            class="text-prompt-preview mt-3 max-h-48 overflow-auto whitespace-pre-wrap [tab-size:2]"
            data-demo-field="prompt"
            tabindex="0"
          >{defaultScenario.prompt}</pre>
        </div>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <button
          type="button"
          data-copy-prompt
          class="focus-ring btn-primary-gold cta-gradient elevate-hover w-full sm:w-auto"
        >
          {demo.copyPrompt}
        </button>
        <PasteDestinationStrip lang={lang} surface="demo" spacing="tight" revealOnCopy />
      </div>
    </div>
  </ContentCard>

  <HighlightStrip variant="band" bandTone="panel" class="mx-auto mt-12 max-w-5xl">
    <p class="type-eyebrow-inline text-brand-accent-hover">
      {demo.followUpEyebrow}
    </p>
    <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm leading-6 text-slate-200 sm:text-base sm:leading-7">
        {demo.followUpText}
      </p>
      <a
        href="#kit"
        class="focus-ring btn-outline-accent elevate-hover shrink-0 rounded-full px-5 py-2.5 text-center text-sm font-bold"
      >
        {demo.followUpCta}
      </a>
    </div>
  </HighlightStrip>
</SectionShell>
