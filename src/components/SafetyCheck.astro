---
import SectionShell from "./ds/SectionShell.astro";
import type { Language } from "../content/copy";
import { uiCopy } from "../content/copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const safety = uiCopy[lang].safety;

/** Fixed scan-row marks (facts → risk → context → owner); order matches `safety.items`. Last uses a geometric glyph (not emoji). */
const checkIcons = ["✓", "⚠", "?", "●"] as const;
---

<SectionShell
  id="safety-check"
  labelledby="safety-check-title"
  rhythm="roomy"
  class="border-t border-white/5"
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,3fr)] lg:items-start lg:gap-12">
    <div>
      <p class="type-eyebrow-promo-bright text-amber-200/90 sm:text-sm">{safety.eyebrow}</p>
      <h2 id="safety-check-title" class="mt-4 text-4xl font-black tracking-tight text-white sm:text-5xl">
        {safety.title}
      </h2>
      <p class="type-body-deck mt-4 max-w-2xl">{safety.subtitle}</p>

      <p class="type-form-label text-amber-200/80">{safety.promptBlockLabel}</p>
      <div
        class="surface-panel relative mt-3 radius-lg border border-amber-200/20 transition-shadow focus-within:shadow-[0_0_0_1px_rgba(251,191,36,0.25)]"
      >
        <pre
          class="max-h-[min(28rem,70vh)] overflow-y-auto p-6 text-left font-mono text-[15px] leading-relaxed text-amber-50/95 whitespace-pre-wrap [tab-size:2]"
          tabindex="0"
          data-safety-full-prompt
        >
          {safety.prompt}
        </pre>
      </div>

      <button
        type="button"
        data-copy-i18n="safety.prompt"
        data-copy-label-i18n="safety.copyPrompt"
        data-copy-copied-i18n="safety.copied"
        class="focus-ring btn-outline-warning type-cta-label elevate-hover mt-6 rounded-full px-5 py-3"
      >
        {safety.copyPrompt}
      </button>
      {safety.previewHint && <p class="mt-4 text-xs leading-5 text-slate-500">{safety.previewHint}</p>}
    </div>

    <aside class="lg:sticky lg:top-28" aria-label={safety.processLabel}>
      <p class="type-eyebrow-promo-bright text-amber-200/80">{safety.processLabel}</p>

      <div class="mt-4 flex flex-col gap-2">
        {
          safety.items.map(([scan, deep], index) => (
            <details class="group surface-panel radius-lg">
              <summary
                class="focus-ring flex cursor-pointer list-none items-start gap-3 radius-lg px-4 py-3 text-left outline-none transition summary-hover [&::-webkit-details-marker]:hidden"
              >
                <span
                  class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-300/10 text-sm text-amber-100/95"
                  aria-hidden="true"
                >
                  {checkIcons[index] ?? "•"}
                </span>
                <span class="text-[15px] font-semibold leading-snug text-white">{scan}</span>
                <svg
                  viewBox="0 0 16 16"
                  width="14"
                  height="14"
                  aria-hidden="true"
                  class="ml-auto mt-1 shrink-0 text-slate-500 transition group-open:rotate-180"
                >
                  <path
                    d="M3 6l5 5 5-5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                </svg>
              </summary>
              <p class="border-t border-white/[0.06] px-4 py-3 pl-[3.75rem] text-sm leading-relaxed text-slate-400">{deep}</p>
            </details>
          ))
        }
      </div>
    </aside>
  </div>
</SectionShell>
